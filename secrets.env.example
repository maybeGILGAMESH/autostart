# Main local secrets file. Copy to secrets.env and fill values on each machine.
# secrets.env is ignored by Git and must not be committed.

# Telegram
TELEGRAM_ENABLED=1
TG_BOT_TOKEN=
TG_CHAT_ID=
TELEGRAM_PROXY_URL=http://127.0.0.1:12334
TELEGRAM_TIMEOUT_SECONDS=12

# Mail/SMTP
MAIL_ENABLED=0
SMTP_HOST=
SMTP_PORT=465
SMTP_SSL=1
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
MAIL_TO=
SMTP_TIMEOUT_SECONDS=12

# Tuna
TUNA_TUNNEL_MODE=tcp
TUNA_TCP_TARGET=22
TUNA_ACCESS_PASSWORD=
TUNA_WAIT_FOR_PROXY_SECONDS=180
TUNA_RESTART_DELAY_SECONDS=5
MAIL_SEND_RETRIES=8
MAIL_SEND_RETRY_DELAY_SECONDS=30
TUNA_ACCESS_NOTIFY_ENABLED=1
